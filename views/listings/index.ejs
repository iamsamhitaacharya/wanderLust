<%=layout("layouts/boilerplate")%>

    <div id="filters" >
      <div class="filters-scroll">
        <a href="/listings?category=trending" class="filter-link">
          <div class="filter">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
          </div>
        </a>
        <a href="/listings?category=rooms" class="filter-link">
          <div class="filter">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
          </div>
        </a>
        <a href="/listings?category=cities" class="filter-link">
          <div class="filter">
            <div><i class="fa-solid fa-mountain-city"></i></div>
            <p>Iconic cities</p>
          </div>
        </a>
        <a href="/listings?category=castles" class="filter-link">
          <div class="filter">
            <div><i class="fa-brands fa-fort-awesome"></i></div>
            <p>Castles</p>
          </div>
        </a>
        <a href="/listings?category=mountains" class="filter-link">
          <div class="filter">
            <div><i class="fa-solid fa-mountain"></i></div>
            <p>Mountains</p>
          </div>
        </a>
        <a href="/listings?category=pools" class="filter-link">
          <div class="filter">
            <div><i class="fa-solid fa-person-swimming"></i></div>
            <p>Amazing pools</p>
          </div>
        </a>
        <a href="/listings?category=camping" class="filter-link">
          <div class="filter">
            <div><i class="fa-solid fa-campground"></i></div>
            <p>Camping</p>
          </div>
        </a>
        <a href="/listings?category=farms" class="filter-link">
          <div class="filter">
            <div><i class="fa-solid fa-cow"></i></div>
            <p>Farms</p>
          </div>
        </a>
        <a href="/listings?category=arctic" class="filter-link">
          <div class="filter">
            <div><i class="fa-solid fa-snowflake"></i></div>
            <p>Arctic</p>
          </div>
        </a>
        <a href="/listings?category=play" class="filter-link">
          <div class="filter">
            <div><i class="fa-solid fa-baseball-bat-ball"></i></div>
            <p>Play</p>
          </div>
        </a>
        <a href="/listings?category=beach" class="filter-link">
          <div class="filter">
            <div><i class="fa-solid fa-umbrella-beach"></i></div>
            <p>Beach</p>
          </div>
        </a>
      </div>
      <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
          <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
          <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
        </div>
      </div>
    </div>

<% if (allListings.length === 0) { %>
  <div class="empty-state text-center">
    <i class="fa-solid fa-map-location-dot empty-state-icon"></i>
    <h4 class="mt-3">No listings found</h4>
    <p class="text-muted">
      No results for "<b><%= search %></b>"<% if (category && category !== "trending") { %> in <b><%= category %></b><% } %>.<br>
      Try a different destination or explore another category.
    </p>
    <a href="/listings" class="btn btn-outline-danger mt-2">Clear filters</a>
  </div>
<% } else { %>
  <div class="row row-cols-lg-5 row-cols-md-4 row-cols-sm-3 row-cols-2 mt-3">
    <% for(let listing of allListings){ %>
      <a href="/listings/<%=listing.id%>">
        <div class="col">
          <div class="card listing-card">
            <img src="<%= listing.image.url%>" class="card-img-top" alt="listing_image" style="height:12rem;">
            <div class="card-img-overlay"></div>
            <div class="card-body">
              <b><%= listing.title %></b>
              <br>
              &#8377;<i class="without-tax-info"><%= listing.price ? listing.price.toLocaleString("en-IN"): "N/A" %>/night</i>
              <i class="with-tax-info"><%= listing.price? (1.18*listing.price).toLocaleString("en-IN"): "N/A" %>/night</i> 
            </div>
          </div>
        </div>
      </a>
    <% } %>
  </div>
<% } %>
 
    <script>
      let taxSwitch = document.getElementById("switchCheckDefault");
      taxSwitch.addEventListener("click", ()=> {
        let withTaxInfo = document.getElementsByClassName("with-tax-info");
        let withoutTaxInfo = document.getElementsByClassName("without-tax-info");
        let i = 0;
        for( let info of withTaxInfo ){
          if(info.style.display!="inline"){
            info.style.display = "inline";
            withoutTaxInfo[i++].style.display = "none";
            }else{
            info.style.display = "none";
            withoutTaxInfo[i++].style.display = "inline";
          }
         
        }
      });
    </script>

